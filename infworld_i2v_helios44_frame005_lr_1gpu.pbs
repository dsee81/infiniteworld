#!/bin/bash
#PBS -N InfWorld_H44_F5_LR_1G
#PBS -l select=1:ncpus=12:mpiprocs=1:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -P personal-dsee009
#PBS -j oe
#PBS -o logs/infworld_i2v_helios44_frame005_lr_1gpu.log

set -euo pipefail

cd "$PBS_O_WORKDIR"

module load cuda/12.2.2
module load gcc/11.2.0

source activate infworld

export PYTHONUNBUFFERED=1
export HF_HOME=/scratch/users/ntu/dsee009/hf_cache
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export TORCH_HOME=/scratch/users/ntu/dsee009/torch_cache
export CUDNN_ROOT=/scratch/users/ntu/dsee009/conda_new_cache/envs/infworld/lib/python3.10/site-packages/nvidia/cudnn
export LD_LIBRARY_PATH=/opt/cray/pe/gcc/11.2.0/snos/lib64:"$CUDNN_ROOT/lib":/app/apps/cuda/12.2.2/lib64:${LD_LIBRARY_PATH:-}
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

export INFWORLD_MAX_TASKS=1
export INFWORLD_NUM_CHUNKS=2
export INFWORLD_CONTEXT_PARALLEL_SIZE=1
export INFWORLD_PROMPTS_YAML=/scratch/users/ntu/dsee009/infworld/Infinite-World/prompts/helios_44_frame005_straight_camera_lr.yaml
export INFWORLD_OUTPUT_BASE=/scratch/users/ntu/dsee009/infworld/Infinite-World/outputs_helios44_frame005_lr_1gpu

mkdir -p logs outputs_helios44_frame005_lr_1gpu "$HF_HOME" "$TRANSFORMERS_CACHE" "$TORCH_HOME"
rm -f logs/infworld_i2v_helios44_frame005_lr_1gpu.log

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Workdir: $(pwd)"
echo "Python: $(which python)"
echo "Prompt yaml: $INFWORLD_PROMPTS_YAML"
echo "Output base: $INFWORLD_OUTPUT_BASE"
echo "Condition image: assets/custom/44_frame005.jpg"

python -c "import torch; print('torch', torch.__version__); print('cuda available', torch.cuda.is_available()); print('cuda devices', torch.cuda.device_count()); print('device0', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'none')"
python - <<'PY'
import json
from collections import Counter
p='assets/custom/44_straight_camera_left_right.json'
a=json.load(open(p))
print('action length', len(a))
print('first action', a[0], 'action@79', a[79], 'action@80', a[80], 'last action', a[-1])
print('counts', Counter((x['move'], x['view']) for x in a))
PY

python scripts/infworld_inference.py
